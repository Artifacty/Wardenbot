# Set the real token securely in the process environment or a local .env file.
DISCORD_TOKEN=
# Test server ID; leave empty to register global commands.
DEV_GUILD_ID=
DB_PATH=data/wardenbot.db
DEFAULT_TZ=Europe/Moscow
# Legacy setting; verified channels are always Russian, public entry channels English.
CHANNEL_NAME_STYLE=ru
LOG_LEVEL=INFO

# Enable in Developer Portal > Bot > Privileged Gateway Intents as well.
# Optional. Operation archives contain cards only and do not need message contents.
MESSAGE_CONTENT_INTENT=false

# Closed briefing opens to signed-up participants 45 minutes before start.
BRIEFING_OPEN_MINUTES=45
