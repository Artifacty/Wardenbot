# Set the real token securely in the process environment or a local .env file.
DISCORD_TOKEN=
# Test server ID; leave empty to register global commands.
DEV_GUILD_ID=
DB_PATH=data/wardenbot.db
DEFAULT_TZ=Europe/Moscow
CHANNEL_NAME_STYLE=full
LOG_LEVEL=INFO

# Enable in Developer Portal > Bot > Privileged Gateway Intents as well.
# Needed to archive participant discussion before deleting operation posts.
MESSAGE_CONTENT_INTENT=false
